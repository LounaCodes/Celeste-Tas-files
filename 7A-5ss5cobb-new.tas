console reset_vanilla_variants
console reset_extended_variants
set ExtendedVariantMode.AddSeekers 5
set ExtendedVariantMode.BadelineChasersEverywhere true
set ExtendedVariantMode.BadelineBossesEverywhere true
set ExtendedVariantMode.BadelineAttackPattern 4
set ExtendedVariantMode.SnowballsEverywhere true
set ExtendedVariantMode.OshiroEverywhere true
set ExtendedVariantMode.SetSeed 3
#Start
# This only works with a slightly modified version of Extended Variants, that sets the seed when the TAS starts.
# My Patched version: https://github.com/LounaCodes/ExtendedVariantMode on the 'internal seeding' branch
# Reload before starting the TAS
#StartRecording
